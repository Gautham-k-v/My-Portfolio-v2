# Copy this file to .env and fill in the values from https://dashboard.emailjs.com
# Never commit the real .env file.

# Email service ID (Email Services)
VITE_EMAILJS_SERVICE_ID=

# Public key (Account → API keys). This key is designed for frontend use.
VITE_EMAILJS_PUBLIC_KEY=

# Template that notifies Gautham of a new enquiry.
# To email: {{to_email}}
# Reply to: {{reply_to}}
# Subject: {{subject}}
# Content: {{{message_html}}}
VITE_EMAILJS_TEMPLATE_ID=

# Template that sends the acknowledgement to the client.
# Use the same To / Reply to / Subject / Content fields as above.
# The site fills to_email with the client's address for this template.
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# The HTML for both emails is built in src/email/messages.js.
# Owner email includes the client's name, contact details, project type,
# budget, timeline, description, and extra requirements.
# Client email includes their name, the project type, a thank-you,
# confirmation that the enquiry was received, and a note that it will be reviewed.
